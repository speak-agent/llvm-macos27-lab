# Pinned inputs of the validation. A change of this file is validated through a pull request.
#
# LLVM_RELEASE_REF: the release/23.x commit from which lld is built. It is the branch head on
# 2026-10-01 and contains the arm64e.x1 support: the cherry-pick 532fa5afbe2b of
# llvm/llvm-project#222721 and its follow-up ee66426152f9 (2026-09-29).
LLVM_RELEASE_REF=21ef2ddb806006eba611b8a769ae72e5f86f9418
LLVM_RELEASE_BRANCH=release/23.x
# LLVM_FIX_COMMIT: the commit that the release ref must contain.
LLVM_FIX_COMMIT=ee66426152f9e7e17f98db4691414ad7cf0c66ea
# LLVM_BASE_RELEASE: the official release whose macOS package supplies clang, the resource
# directory, the other tools and the stock ld64.lld used as the negative control.
LLVM_BASE_RELEASE=23.1.2
